# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Shopify Storefront API ────────────────────────────────
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=klicknkart.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_token

# ── Shopify Customer Account API (OAuth + GraphQL) ────────
SHOPIFY_SHOP_ID=your_numeric_shop_id
NEXT_PUBLIC_SHOPIFY_SHOP_ID=your_numeric_shop_id
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_customer_account_client_id

# ── Shopify Webhooks ──────────────────────────────────────
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret